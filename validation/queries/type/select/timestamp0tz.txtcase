// part: metadata

[tags]
caveats = ["DataFusion timestamps use nanosecond-backed storage and are limited to approximately 1677 through 2262.", "DataFusion does not preserve timezone metadata in Arrow output"]

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INTEGER,
    res TIMESTAMP(0) WITH TIME ZONE
);

INSERT INTO test_timestamptz (idx, res) VALUES (1, TIMESTAMP WITH TIME ZONE '2023-05-15 13:45:30+00');
INSERT INTO test_timestamptz (idx, res) VALUES (2, TIMESTAMP WITH TIME ZONE '2000-01-01 00:00:00+00');
INSERT INTO test_timestamptz (idx, res) VALUES (3, TIMESTAMP WITH TIME ZONE '1969-07-20 20:17:40+00');
INSERT INTO test_timestamptz (idx, res) VALUES (4, TIMESTAMP WITH TIME ZONE '1677-09-21 00:12:44+00');
INSERT INTO test_timestamptz (idx, res) VALUES (5, TIMESTAMP WITH TIME ZONE '2262-04-11 23:47:16+00');
INSERT INTO test_timestamptz (idx, res) VALUES (6, NULL);


// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tss:",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330}
{"res": 946684800}
{"res": -14182940}
{"res": -9223372036}
{"res": 9223372036}
{"res": null}
