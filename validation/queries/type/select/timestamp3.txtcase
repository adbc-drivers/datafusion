// part: metadata

[tags]
sql-type-name = "TIMESTAMP(3)"
caveats = ["DataFusion timestamps use nanosecond-backed storage and are limited to approximately 1677 through 2262."]

// part: setup_query

CREATE TABLE test_timestamp (
    idx INTEGER,
    res TIMESTAMP(3)
);

INSERT INTO test_timestamp (idx, res) VALUES (1, TIMESTAMP '2023-05-15 13:45:30.123');
INSERT INTO test_timestamp (idx, res) VALUES (2, TIMESTAMP '2000-01-01 00:00:00.234');
INSERT INTO test_timestamp (idx, res) VALUES (3, TIMESTAMP '1969-07-20 20:17:40.345');
INSERT INTO test_timestamp (idx, res) VALUES (4, TIMESTAMP '1677-09-21 00:12:43.146');
INSERT INTO test_timestamp (idx, res) VALUES (5, TIMESTAMP '2262-04-11 23:47:16.854');
INSERT INTO test_timestamp (idx, res) VALUES (6, NULL);

// part: expected

{"res": 1684158330123}
{"res": 946684800234}
{"res": -14182939655}
{"res": -9223372036854}
{"res": 9223372036854}
{"res": null}
